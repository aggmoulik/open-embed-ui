{
  "name": "github-embed-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @github-embed-ui/dashboard dev",
    "build": "pnpm --filter @github-embed-ui/dashboard build",
    "start": "pnpm --filter @github-embed-ui/dashboard start",
    "lint": "pnpm --filter @github-embed-ui/dashboard lint",
    "build:widget": "pnpm --filter @github-embed-ui/widget build && cp packages/widget/dist/widget.js apps/dashboard/public/widget.js",
    "dev:widget": "pnpm --filter @github-embed-ui/widget dev",
    "preview:widget": "pnpm --filter @github-embed-ui/widget preview",
    "db:push": "pnpm --filter @github-embed-ui/dashboard db:push",
    "db:studio": "pnpm --filter @github-embed-ui/dashboard db:studio",
    "db:seed": "pnpm --filter @github-embed-ui/dashboard db:seed"
  }
}
