{
  "name": "github-embed-ui",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "pnpm db:push && turbo dev --filter=@github-embed-ui/dashboard --ui=stream",
    "dev:all": "pnpm db:push && turbo dev --filter=@github-embed-ui/dashboard --filter=@github-embed-ui/preview",
    "dx": "pnpm install && pnpm db:push && pnpm db:seed",
    "build": "turbo build",
    "build:widget": "turbo build --filter=@github-embed-ui/widget && cp packages/widget/dist/widget.js apps/dashboard/public/widget.js",
    "start": "pnpm --filter @github-embed-ui/dashboard start",
    "lint": "turbo lint",
    "dev:widget": "pnpm --filter @github-embed-ui/widget dev",
    "preview:widget": "turbo build --filter=@github-embed-ui/widget && pnpm --filter @github-embed-ui/widget preview",
    "preview": "pnpm --filter @github-embed-ui/preview dev",
    "build:preview": "turbo build --filter=@github-embed-ui/preview",
    "db:push": "pnpm --filter @github-embed-ui/db db:push",
    "db:generate": "pnpm --filter @github-embed-ui/db db:generate",
    "db:migrate": "pnpm --filter @github-embed-ui/db db:migrate",
    "db:studio": "pnpm --filter @github-embed-ui/db db:studio",
    "db:seed": "pnpm --filter @github-embed-ui/db db:seed",
    "setup": "pnpm install && cp -n packages/db/.env.example packages/db/.env && cp -n apps/dashboard/.env.example apps/dashboard/.env && pnpm db:push",
    "ui:add": "cd packages/ui && pnpm dlx shadcn@latest add"
  },
  "devDependencies": {
    "turbo": "2.9.3"
  }
}
