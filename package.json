{
  "name": "open-embed-ui",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "pnpm db:push && turbo dev --filter=@open-embed-ui/dashboard --ui=stream",
    "dev:all": "pnpm db:push && turbo dev --filter=@open-embed-ui/dashboard --filter=@open-embed-ui/preview",
    "dx": "pnpm install && pnpm db:push && pnpm db:seed",
    "build": "turbo build",
    "build:widget": "turbo build --filter=@open-embed-ui/widget && cp packages/widget/dist/widget.js apps/dashboard/public/widget.js && pnpm check:bundle-size",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "start": "pnpm --filter @open-embed-ui/dashboard start",
    "lint": "turbo lint",
    "dev:widget": "pnpm --filter @open-embed-ui/widget dev",
    "preview:widget": "turbo build --filter=@open-embed-ui/widget && pnpm --filter @open-embed-ui/widget preview",
    "preview": "pnpm --filter @open-embed-ui/preview dev",
    "build:preview": "turbo build --filter=@open-embed-ui/preview",
    "db:push": "pnpm --filter @open-embed-ui/db db:push",
    "db:generate": "pnpm --filter @open-embed-ui/db db:generate",
    "db:migrate": "pnpm --filter @open-embed-ui/db db:migrate",
    "db:studio": "pnpm --filter @open-embed-ui/db db:studio",
    "db:seed": "pnpm --filter @open-embed-ui/db db:seed",
    "setup": "pnpm install && cp -n packages/db/.env.example packages/db/.env && cp -n apps/dashboard/.env.example apps/dashboard/.env && pnpm db:push",
    "ui:add": "pnpm --filter @open-embed-ui/ui shadcn add",
    "export:widget": "tsx --env-file=packages/db/.env scripts/export-widget.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd"]
  },
  "devDependencies": {
    "@open-embed-ui/db": "workspace:*",
    "tsx": "4.21.0",
    "turbo": "2.9.3"
  }
}
