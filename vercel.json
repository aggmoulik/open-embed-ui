{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build:widget && pnpm --filter @open-embed-ui/dashboard build",
  "outputDirectory": "apps/dashboard/.next",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- apps/dashboard packages/db packages/types packages/ui packages/widget",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  }
}
