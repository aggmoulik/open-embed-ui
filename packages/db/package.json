{
  "name": "@open-embed-ui/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env src/seed.ts",
    "test": "node --test --import tsx src/lib/*.test.ts"
  },
  "dependencies": {
    "@open-embed-ui/types": "workspace:*",
    "@libsql/client": "0.17.2",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@types/node": "20.19.37",
    "drizzle-kit": "0.31.10",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
