# Database (points to packages/db local file)
TURSO_DATABASE_URL=file:../../packages/db/local.db
# TURSO_AUTH_TOKEN=your-turso-auth-token

# GitHub OAuth (create at https://github.com/settings/applications/new)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Auth
# REQUIRED: ≥ 32 random bytes (256 bits). Generate with:
#   openssl rand -base64 32
# better-auth warns at startup if too short or low-entropy. Reusing the
# same secret across environments rotates ALL sessions when changed.
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Deploy guard — set to "public" only when ready to launch the dashboard publicly.
# Any other value (or unset) blocks dashboard routes in production with a 503 page.
# Public routes (/api/embed/*, /api/og/*, /u/*, /widget.js) always work regardless.
# Has no effect in dev (NODE_ENV !== "production").
DEPLOY_MODE=local
